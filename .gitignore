# ==============================================================================
# PROJECT: Estokar - Complete .gitignore
# Stack: Node.js, NestJS (Backend), Next.js (Web), Expo (Mobile)
# ==============================================================================

# [DEPENDENCIES]
node_modules/
.pnp
.pnp.*
package-lock.json.log
yarn-error.log

# [ENVIRONMENT / SECRETS]
# Never commit sensitive environment variables or private keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
certs/

# [BUILD OUTPUTS]
dist/
build/
out/
.next/
.swc/
*.tsbuildinfo

# [MOBILE - EXPO / REACT NATIVE]
.expo/
*.jks
*.p12
*.key
*.mobileprovision
# Android artifacts
android/app/build/
android/.gradle/
# iOS artifacts
ios/build/
ios/Pods/
ios/.xccheckout
ios/*.xcworkspace

# [TESTING]
/coverage
/.nyc_output
junit.xml

# [LOGS]
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# [IDE - VS CODE]
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# [IDE - JETBRAINS (IntelliJ, WebStorm, etc.)]
.idea/
*.iws
*.iml
*.ipr

# [OS - SYSTEM FILES]
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# [DOCKER]
.docker/

# [TEMPORARY FILES]
.temp/
.tmp/
pids
*.pid
*.seed
*.pid.lock

# [DIAGNOSTIC REPORTS]
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
